# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/membership_system?schema=public"

# JWT
JWT_SECRET="change-this-secret-in-production-min-32-characters-long"
JWT_EXPIRES_IN="7d"

# Organization settings
ORG_NAME="FITSPA"
ORG_TIMEZONE="Africa/Kampala"
ORG_CURRENCY="UGX"

# Scheduled jobs: protects GET /api/cron/run
CRON_SECRET="generate-a-random-string"

# Email delivery for automated reminders
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""

# Bootstrap administrator for `npm run db:seed`
SEED_ADMIN_EMAIL="admin@fitspa.ug"
SEED_ADMIN_PASSWORD="ChangeMe123!"

# Document storage directory (outside the web root)
STORAGE_DIR="./storage/documents"